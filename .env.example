# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=e_commerce
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_URL=jdbc:mysql://localhost:3306/e_commerce?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# JWT Settings
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Mail Server Configurations
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_username@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Payment Gateway Settings
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Application URL Configurations
APP_RESET_PASSWORD_URL=http://localhost:5173/reset-password
VITE_API_BASE_URL=http://localhost:8080/api